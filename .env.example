# Copy this file to ".env" and paste your Binance API keys here.
# NEVER share this file, commit it to GitHub, or paste the keys in a chat.
#
# On Binance, create the key with "Enable Spot & Margin Trading" (and
# "Enable Futures" only if you turn futures on). Leave "Enable Withdrawals" OFF.
# Use a separate key for paper testing and for live trading.
BINANCE_API_KEY=
BINANCE_API_SECRET=
